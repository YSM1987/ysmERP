[Unit]
Description=ysmERP (Spring Boot)
Documentation=https://github.com/__GITHUB_REPO__
After=network.target mysql.service redis.service
Wants=network.target
StartLimitIntervalSec=180
StartLimitBurst=10

[Service]
# JVM 参数外置于环境文件（对齐 3x-ui /etc/default/x-ui 模式），改参数无需动 unit
EnvironmentFile=-/etc/default/ysmERP
Type=simple
User=ysmERP
Group=ysmERP
WorkingDirectory=/usr/local/ysmERP
# ${JAVA_OPTS} 来自 /etc/default/ysmERP。
# 注意：这里必须写 $JAVA_OPTS（不能写 ${JAVA_OPTS}）——systemd 对 ${VAR} 只做整体替换不按空格拆分，
# 会把整串 JVM 参数当成一个参数传给 java，导致 "Invalid initial heap size" 启动失败。
ExecStart=/usr/bin/java $JAVA_OPTS -jar /usr/local/ysmERP/ysmERP.jar --spring.config.additional-location=file:/etc/ysmERP/application.yml
Restart=on-failure
RestartSec=5s

# ---- 1GB 甲骨文免费机资源约束（cgroup 层兜底，防 Java 挤死 MySQL/系统）----
MemoryHigh=700M
MemoryMax=800M
CPUQuota=90%
Nice=8
OOMScoreAdjust=200

# ---- 日志：stdout/stderr 进 journald（ysmERP log 查看；app 自身每日滚动写 logs/）----
StandardOutput=journal
StandardError=journal

# ---- 安全加固（对齐 3x-ui unit 沙箱风格，Java 服务适用子集）----
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=-/usr/local/ysmERP -/etc/ysmERP
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
